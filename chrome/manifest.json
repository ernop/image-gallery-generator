{
  "manifest_version": 3,
  "name": "4Chan Gallery Viewer WG",
  "short_name": "GalleryView",
  "version": "0.0.43",
  "description": "Adds gallery button to 4chan thread views with keyboard shortcuts for fast image browsing and saving.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": "icon.png"
  },
  "content_scripts": [{
    "js": [
      "browser-polyfill.js",
      "jquery.js",
      "util.js",
      "settingsModule.js",
      "labelsModule.js",
      "main.js"
    ],
    "css": ["styles.css"],
    "matches": [
      "*://boards.4chan.org/*",
      "*://boards.4channel.org/*"
    ]
  }],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon-128.png"
  }
}
